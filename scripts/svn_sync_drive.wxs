<?xml version="1.0" encoding="UTF-8"?>
<!-- SvnSyncDrive MSI installer (WiX 3.14). Per-user install.
     Parameters: candle -dStageDir=<staged layout> -dVersion=<version>
   heat.exe dir <stage> -cg MainComponentGroup -gg -scom -sreg -srd -sfrag -su \
       -dr INSTALLDIR -var var.StageDir -o components.wxs -->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*" Name="SvnSyncDrive" Language="1033" Version="$(var.Version)"
           Manufacturer="vxling" UpgradeCode="D2A31A20-57B1-4E3B-9F5C-7D2E6C1A8B40">
    <Package InstallerVersion="500" Compressed="yes" InstallScope="perUser"
             Description="SvnSyncDrive installer" Manufacturer="vxling"
             Comments="SvnSyncDrive" />
    <MajorUpgrade DowngradeErrorMessage="A newer version of SvnSyncDrive is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="LocalAppDataFolder">
        <Directory Id="ProgramsFolder" Name="Programs">
          <Directory Id="INSTALLDIR" Name="SvnSyncDrive" />
        </Directory>
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ApplicationProgramsFolder" Name="SvnSyncDrive" />
      </Directory>
    </Directory>
    <Feature Id="Main" Title="SvnSyncDrive" Level="1">
      <ComponentGroupRef Id="MainComponentGroup" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="RemoveInstallDir" />
    </Feature>
    <Component Id="StartMenuShortcut" Directory="ApplicationProgramsFolder" Guid="*">
      <Shortcut Id="SvnSyncDriveShortcut" Name="SvnSyncDrive"
                Target="[INSTALLDIR]svnsyncdrive.exe" WorkingDirectory="INSTALLDIR" />
      <RemoveFolder Id="ApplicationProgramsFolder" On="uninstall" />
      <RegistryValue Root="HKCU" Key="Software\vxling\SvnSyncDrive" Name="installed"
                     Type="integer" Value="1" KeyPath="yes" />
    </Component>
    <Component Id="RemoveInstallDir" Directory="INSTALLDIR" Guid="*">
      <RemoveFolder Id="RemoveInstallDirFolder" On="uninstall" />
      <RegistryValue Root="HKCU" Key="Software\vxling\SvnSyncDrive" Name="installDir"
                     Type="string" Value="[INSTALLDIR]" KeyPath="yes" />
    </Component>
    <UI>
      <UIRef Id="WixUI_Minimal" />
    </UI>
  </Product>
</Wix>
